# ============================================================
# VoxGuard — Environment Configuration
# ============================================================
# Copy to .env and replace CHANGE_ME values.
# NEVER commit .env to version control.
# ============================================================

# --- General ---
APP_ENV=local

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=voxguard_admin
POSTGRES_PASSWORD=CHANGE_ME_pg_admin_password

# Per-service database URLs
AUTH_DATABASE_URL=postgresql+asyncpg://auth_app:CHANGE_ME_auth_db_pass@postgres:5432/auth_db
VOTER_DATABASE_URL=postgresql+asyncpg://voter_app:CHANGE_ME_voter_db_pass@postgres:5432/voter_db
BALLOT_DATABASE_URL=postgresql+asyncpg://ballot_app:CHANGE_ME_ballot_db_pass@postgres:5432/ballot_db
AUDIT_DATABASE_URL=postgresql+asyncpg://audit_app:CHANGE_ME_audit_db_pass@postgres:5432/audit_db
RESULT_DATABASE_URL=postgresql+asyncpg://result_app:CHANGE_ME_result_db_pass@postgres:5432/result_db
SECURITY_DATABASE_URL=postgresql+asyncpg://security_app:CHANGE_ME_security_db_pass@postgres:5432/security_db

# Alembic (sync driver)
AUTH_DATABASE_URL_SYNC=postgresql://auth_app:CHANGE_ME_auth_db_pass@postgres:5432/auth_db
VOTER_DATABASE_URL_SYNC=postgresql://voter_app:CHANGE_ME_voter_db_pass@postgres:5432/voter_db
BALLOT_DATABASE_URL_SYNC=postgresql://ballot_app:CHANGE_ME_ballot_db_pass@postgres:5432/ballot_db
AUDIT_DATABASE_URL_SYNC=postgresql://audit_app:CHANGE_ME_audit_db_pass@postgres:5432/audit_db
RESULT_DATABASE_URL_SYNC=postgresql://result_app:CHANGE_ME_result_db_pass@postgres:5432/result_db
SECURITY_DATABASE_URL_SYNC=postgresql://security_app:CHANGE_ME_security_db_pass@postgres:5432/security_db

# --- RabbitMQ ---
RABBITMQ_URL=amqp://voxguard:CHANGE_ME_rabbitmq_pass@rabbitmq:5672/voxguard
RABBITMQ_DEFAULT_USER=voxguard
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_pass
RABBITMQ_DEFAULT_VHOST=voxguard

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT / Auth Secrets ---
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Service Secrets ---
VOTE_TICKET_SECRET=CHANGE_ME_vote_ticket_secret
ELIGIBILITY_PEPPER=CHANGE_ME_eligibility_pepper
RECEIPT_SECRET=CHANGE_ME_receipt_secret
FINGERPRINT_SECRET=CHANGE_ME_fingerprint_secret
INTERNAL_API_KEY=CHANGE_ME_internal_api_key
AUDIT_CHECKPOINT_KEY=CHANGE_ME_audit_checkpoint_key

# --- Attack Lab ---
ATTACK_LAB_ENABLED=false

# --- API Gateway upstream URLs ---
AUTH_SERVICE_URL=http://auth-service:8001
VOTER_SERVICE_URL=http://voter-service:8002
BALLOT_SERVICE_URL=http://ballot-service:8003
AUDIT_SERVICE_URL=http://audit-service:8004
RESULT_SERVICE_URL=http://result-service:8005
SECURITY_SERVICE_URL=http://security-service:8006

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
